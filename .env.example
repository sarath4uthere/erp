# Copy to .env for local development. Never commit .env.
# All values below are DEV-ONLY placeholders. Use strong, unique values locally.

# --- SQL Server ---------------------------------------------------------------
# Must meet SQL Server complexity rules (8+ chars, 3 of 4 character classes).
MSSQL_SA_PASSWORD=LocalDev!Sql2022_ChangeMe
MSSQL_DATABASE=mini_erp
MSSQL_PORT=1433
MSSQL_MEMORY_LIMIT=2G

# --- API ----------------------------------------------------------------------
API_PORT=8080
ASPNETCORE_ENVIRONMENT=Development
# Generate with: openssl rand -base64 48  (min 32 bytes; never reuse across envs)
JWT_SIGNING_KEY=dev-only-not-a-real-key-replace-before-running
JWT_ISSUER=mini-erp
JWT_AUDIENCE=mini-erp-web
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
ASPNETCORE_FORWARDEDHEADERS_ENABLED=true

# --- Web ----------------------------------------------------------------------
WEB_PORT=5173
VITE_API_BASE_URL=http://localhost:8080

# --- Observability ------------------------------------------------------------
LOG_LEVEL=Information
